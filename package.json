{
  "name": "oxoflow",
  "productName": "OxoFlow",
  "version": "1.6.1",
  "description": "Dictée vocale 100 % locale pour Windows et macOS : tu parles, le texte s'écrit là où tu tapes.",
  "main": "main.js",
  "author": "Martin (OxoFlow), d’après FreeFlow d’Alan",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/martinleonardcyber-ops/oxoflow",
  "repository": {
    "type": "git",
    "url": "https://github.com/martinleonardcyber-ops/oxoflow.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\" && python3 test/test_stt_server.py",
    "build:stt": "python stt/build_stt.py",
    "setup:mac": "sh scripts/setup-mac.sh",
    "package:mac": "sh scripts/build-mac.sh",
    "site:demo": "sh scripts/build-site-demo.sh",
    "build:native:mac": "swiftc -O -o native/PasteHelperMac native/PasteHelperMac.swift && swiftc -O -o native/FnKeyMac native/FnKeyMac.swift",
    "build:native": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /optimize /target:exe /out:native\\PasteHelper.exe native\\PasteHelper.cs",
    "package": "npx @electron/packager . OxoFlow --platform=win32 --arch=x64 --overwrite --icon=assets/icon.ico --extra-resource=stt/dist/freeflow-stt --extra-resource=native/PasteHelper.exe --out=dist --ignore=\"^/stt($|/)\" --ignore=\"^/native/PasteHelper\\.cs$\" --ignore=\"^/screenshots($|/)\" --ignore=\"^/dist($|/)\" --ignore=\"^/release($|/)\" --ignore=\"^/installer($|/)\" --ignore=\"^/docs($|/)\" --ignore=\"^/dev($|/)\" --ignore=\"^/test($|/)\" --ignore=\"^/site($|/)\" --ignore=\"^/\\.github($|/)\" --ignore=\"^/\\.git($|/)\" --ignore=\"^/\\.gitignore$\" --ignore=\"^/assets/make_.*\\.py$\" --ignore=\"^/assets/dmg-background\" --ignore=\"^/README\\.md$\"",
    "package:release": "npx @electron/packager . OxoFlow --platform=win32 --arch=x64 --overwrite --icon=assets/icon.ico --extra-resource=stt/dist/freeflow-stt --extra-resource=native/PasteHelper.exe --out=release --ignore=\"^/stt($|/)\" --ignore=\"^/native/PasteHelper\\.cs$\" --ignore=\"^/screenshots($|/)\" --ignore=\"^/dist($|/)\" --ignore=\"^/release($|/)\" --ignore=\"^/installer($|/)\" --ignore=\"^/docs($|/)\" --ignore=\"^/dev($|/)\" --ignore=\"^/test($|/)\" --ignore=\"^/site($|/)\" --ignore=\"^/\\.github($|/)\" --ignore=\"^/\\.git($|/)\" --ignore=\"^/\\.gitignore$\" --ignore=\"^/assets/make_.*\\.py$\" --ignore=\"^/assets/dmg-background\" --ignore=\"^/README\\.md$\"",
    "installer": "electron-builder --win nsis --x64 --prepackaged release/OxoFlow-win32-x64 --publish never",
    "release": "npm run package:release && npm run installer"
  },
  "build": {
    "appId": "com.oxoria.oxoflow",
    "productName": "OxoFlow",
    "copyright": "© 2026 Alan — licence MIT",
    "directories": {
      "output": "release/installer",
      "buildResources": "installer"
    },
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "OxoFlow",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "multiLanguageInstaller": false,
      "unicode": true,
      "differentialPackage": false,
      "deleteAppDataOnUninstall": false,
      "include": "installer/installer.nsh",
      "artifactName": "OxoFlow-Setup.exe",
      "uninstallDisplayName": "OxoFlow"
    }
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  }
}
